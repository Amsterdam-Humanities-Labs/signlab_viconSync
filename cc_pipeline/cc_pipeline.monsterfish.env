# Values for running the backfill on monsterfish (24 cores, /mnt/fishbowl NVMe).
# The root filesystem there is full, so every writable path must sit on
# /mnt/fishbowl - including the npm cache and TMPDIR, or Blender and npm fail
# with ENOSPC.
export CC_REPO=/mnt/fishbowl/gomer/fbxconv/repo
export CC_BLENDER=/home/gomer/blender-5.0.0-linux-x64/blender
export CC_NODE=/usr/bin/node
export CC_AVATAR=/mnt/fishbowl/gomer/fbxconv/PalmerPolo1024uastc.glb
export CC_MORPH_ORDER=/mnt/fishbowl/gomer/fbxconv/repo/palmerpolo_morph_order.txt
export CC_IN_DIR=/mnt/fishbowl/gomer/fbxconv/fbx
export CC_OUT_DIR=/mnt/fishbowl/gomer/fbxconv/out
export CC_JOBS=20
export TMPDIR=/mnt/fishbowl/gomer/fbxconv/.tmp
export npm_config_cache=/mnt/fishbowl/gomer/fbxconv/.npm
