+# LOCAL PATCH (viconSync): Blender 4.4 moved F-curves out of Action.fcurves and
+# into slotted layers/strips/channelbags, and 5.x removed the old attribute
+# outright ("'Action' object has no attribute 'fcurves'"). This reaches the
+# curves either way. Only the Blender sampler needs it - Character Creator FBX
+# take the direct-parse fast path and never get here, which is why post-processed
+# Unreal exports were the first files to hit it.
+def _action_fcurves(action):
+    fcurves = getattr(action, "fcurves", None)
+    if fcurves is not None:
+        for fc in fcurves:
+            yield fc
+        return
+    for layer in getattr(action, "layers", []):
+        for strip in getattr(layer, "strips", []):
+            for bag in getattr(strip, "channelbags", []):
+                for fc in getattr(bag, "fcurves", []):
+                    yield fc
+
