# Paths for the CC conversion pipeline. Sourced by convert_all.sh; convert_one.sh
# reads the same names from the environment. Override per host by exporting them
# before the call (see cc_pipeline.monsterfish.env for the compute-host values).

# FBXtoGLBCompression checkout (github.com/J-Andersen-UvA/FBXtoGLBCompression)
export CC_REPO=/home/gomer/FBXtoGLBCompression

# Blender >= 3.6. Portable build, not on PATH.
export CC_BLENDER=/home/gomer/blender-5.0.1-linux-x64/blender

# Node binary. nvm only exports this for interactive shells, so systemd units
# need it named explicitly.
export CC_NODE=/home/gomer/.nvm/versions/node/v22.20.0/bin/node

# CC avatar the animations are retargeted onto. This is BASE_CHARACTER_URL in
# /web/zin/3DAnn3.html - the two must stay in step or the skeletons diverge.
export CC_AVATAR=/web/zin/PalmerPolo1024uastc.glb

# The avatar's morph target order, extracted with gltf-transform.
export CC_MORPH_ORDER=/home/gomer/FBXtoGLBCompression/out/palmerpolo_morph_order.txt

# Source FBX files and where the GLB + JSON pairs land.
export CC_IN_DIR=/web/gebarenoverleg_media/fbx/CC
export CC_OUT_DIR=/web/gebarenoverleg_media/fbx/cc_pipeline

# Post-processed uploads from /animMIDI (UploadController writes here). These
# carry the corrected body take but NO facial blendshape animation - Unreal
# strips it - so their sidecar JSON is written but empty. Converted separately so
# the raw CC output stays available for comparison.
export CC_PP_IN_DIR=/web/gebarenoverleg_media/fbx/post_processed
export CC_PP_OUT_DIR=/web/gebarenoverleg_media/fbx/cc_pipeline_pp
