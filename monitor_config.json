{
  "ftp": {
    "host_prefix": "vicon",
    "user": "vicon",
    "password": "CHANGE_ME",
    "timeout": 10,
    "base_path": "/e/Recordings"
  },
  "monitoring": {
    "poll_interval": 1.5,
    "recent_days_threshold": 7,
    "active_recording_timeout": 600,
    "date_dir_cache_ttl": 60,
    "recording_dir_cache_ttl": 30,
    "max_connection_retries": 5,
    "retry_backoff_base": 1,
    "retry_backoff_max": 60
  },
  "file_types": {
    "unreal": [".fbx", ".glb"],
    "vicon": [".fbx"],
    "obs": [".mkv"],
    "note": "All other file types (.mp4, .avi, .png, .jpg, .txt, .csv, .json, etc.) are tracked in 'other' category"
  },
  "output": {
    "json_file": "monitor_output.json",
    "state_file": "monitor_state.json",
    "log_file": "logs/ftp_monitor.log"
  },
  "client_monitor": {
    "enabled": true,
    "api_url": "https://signcollect.nl/client_monitor_api/api.php",
    "client_id": "vicon-ftp-monitor",
    "client_name": "Vicon FTP Monitor",
    "description": "Monitors Vicon FTP server for file changes and syncs to database",
    "heartbeat_interval": 90,
    "send_stats": true
  },
  "glb_matcher": {
    "glb_base_path": "/web/gebarenoverleg_media/fbx",
    "check_interval": 300,
    "batch_size": "all",
    "log_file": "logs/glb_matcher.log",
    "client_monitor": {
      "enabled": true,
      "api_url": "https://signcollect.nl/client_monitor_api/api.php",
      "client_id": "vicon-glb-matcher",
      "client_name": "Vicon GLB Matcher",
      "description": "Matches FBX files with corresponding GLB files in the media directory",
      "heartbeat_interval": 300
    }
  },
  "blackmagic_mini": {
    "enabled": true,
    "source_path": "/web/gebarenoverleg_media/studioFiles/blackmagic_files",
    "dest_path": "/mnt/bigstorage/blackmagic_filesMini",
    "state_file": "blackmagic_compress_state.json",
    "log_file": "logs/blackmagic_mini.log",
    "skip_log": "logs/blackmagic_mini_skipped.log",
    "workers": 3,
    "max_attempts": 5,
    "encode": {
      "ssh_host": "monsterfish",
      "scale_width": 1920,
      "scale_height": 1080,
      "codec": "libx265",
      "crf": 26,
      "preset": "fast"
    },
    "client_monitor": {
      "enabled": true,
      "api_url": "https://signcollect.nl/client_monitor_api/api.php",
      "client_id": "vicon-blackmagic-mini",
      "client_name": "Vicon Blackmagic Mini Compressor",
      "description": "Compresses Blackmagic 6K clips to 1080p Mini copies",
      "heartbeat_interval": 86400
    }
  }
}
